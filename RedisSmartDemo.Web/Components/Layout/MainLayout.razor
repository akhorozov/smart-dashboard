@inherits LayoutComponentBase

<FluentDesignSystemProvider>
    <div class="app-shell">
        <aside class="app-sidebar">
            <NavMenu />
        </aside>

        <article class="app-content">
            @Body
        </article>
    </div>
</FluentDesignSystemProvider>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

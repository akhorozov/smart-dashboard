@page "/recommendations"
@rendermode InteractiveServer

@inject RecommendationsApiClient RecommendationsApi

<PageTitle>Recommendations</PageTitle>

<h1>Recommendations</h1>

<div class="mb-3">
    <label class="form-label" for="user-select">User</label>
    <select id="user-select"
            class="form-select"
            @bind="selectedUserId"
            @bind:after="OnSelectedUserChangedAsync"
            disabled="@isLoadingUsers">
        <option value="">Select a user...</option>
        @foreach (var user in users)
        {
            <option value="@user.Id">@user.Name (@user.Id)</option>
        }
    </select>
</div>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="EmbedAllProductsAsync" disabled="@isEmbeddingProducts">
        Embed All Products
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <p>@statusMessage</p>
}

@if (isLoadingRecommendations)
{
    <p><em>Loading recommendations...</em></p>
}
else if (recommendations.Length > 0)
{
    <ol class="list-group list-group-numbered">
        @foreach (var recommendation in recommendations)
        {
            <li class="list-group-item d-flex justify-content-between align-items-start">
                <div class="ms-2 me-auto">
                    <div class="fw-bold">@recommendation.ProductName</div>
                    @recommendation.ProductId
                </div>
                <span class="badge bg-primary rounded-pill">@FormatSimilarityPercentage(recommendation.SimilarityScore)</span>
            </li>
        }
    </ol>
}
else if (!string.IsNullOrWhiteSpace(selectedUserId))
{
    <p>No recommendations found for the selected user.</p>
}

@code {
    private UserSummary[] users = [];
    private ProductRecommendation[] recommendations = [];
    private string selectedUserId = "";
    private string? statusMessage;
    private bool isLoadingUsers;
    private bool isLoadingRecommendations;
    private bool isEmbeddingProducts;

    protected override async Task OnInitializedAsync()
    {
        isLoadingUsers = true;

        try
        {
            users = await RecommendationsApi.GetUsersAsync();
        }
        catch
        {
            statusMessage = "Failed to load users from the API. Please try again later.";
        }
        finally
        {
            isLoadingUsers = false;
        }
    }

    private async Task OnSelectedUserChangedAsync()
    {
        recommendations = [];
        statusMessage = null;

        if (string.IsNullOrWhiteSpace(selectedUserId))
        {
            return;
        }

        isLoadingRecommendations = true;

        try
        {
            recommendations = await RecommendationsApi.GetRecommendationsAsync(selectedUserId);
        }
        catch
        {
            statusMessage = "Failed to load recommendations for the selected user. Please try again.";
        }
        finally
        {
            isLoadingRecommendations = false;
        }
    }

    private async Task EmbedAllProductsAsync()
    {
        statusMessage = null;
        isEmbeddingProducts = true;

        try
        {
            var products = await RecommendationsApi.GetProductsAsync();
            const int maxConcurrentEmbeds = 4;
            var cancellationToken = CancellationToken.None;
            var successfulEmbeds = 0;
            var failedEmbeds = 0;
            using var semaphore = new SemaphoreSlim(maxConcurrentEmbeds);

            await Task.WhenAll(products.Select(async product =>
            {
                await semaphore.WaitAsync(cancellationToken);

                try
                {
                    await RecommendationsApi.EmbedProductAsync(product.Id, cancellationToken);
                    Interlocked.Increment(ref successfulEmbeds);
                }
                catch
                {
                    Interlocked.Increment(ref failedEmbeds);
                }
                finally
                {
                    semaphore.Release();
                }
            }));

            statusMessage = failedEmbeds == 0
                ? $"Embedded {successfulEmbeds} products."
                : $"Embedded {successfulEmbeds} products, {failedEmbeds} failed.";
        }
        catch
        {
            statusMessage = "Failed to embed one or more products. Please check the API service and try again.";
        }
        finally
        {
            isEmbeddingProducts = false;
        }
    }

    private static string FormatSimilarityPercentage(double similarityScore)
    {
        var percentage = similarityScore <= 1 ? similarityScore * 100 : similarityScore;
        return $"{percentage:F2}%";
    }
}
